# Postgres shared with tund-server (the server owns the schema/migrations).
TUND_DATABASE_URL=postgres://tund:tund@localhost:55432/tund

# Public addressing — must match the server.
TUND_BASE_DOMAIN=tund.example.com
TUND_DASHBOARD_HOST=dashboard.tund.example.com
TUND_PUBLIC_SCHEME=https
# Only set when the edge listens on a non-default port (dev), e.g. 8080.
TUND_PUBLIC_PORT=

# Internal API of tund-server (replay, stop tunnel).
TUND_INTERNAL_URL=http://server:4040
TUND_INTERNAL_SECRET=change-me

# Public IP of the edge, shown in custom domain DNS instructions.
TUND_SERVER_IP=203.0.113.10

# The variables below are only defaults: admins can override them at runtime under
# Admin → Settings (stored in the database; "reset to default" falls back to these).

# Allow anyone to create an account. The very first account is always allowed and becomes admin.
TUND_ALLOW_SIGNUP=false

# Per-account limits (0 = unlimited; admins are exempt).
# Static hostnames (subdomains pinned to an account), enforced by the dashboard and the server.
TUND_MAX_PINNED_PER_USER=0
# Custom domains, enforced by the dashboard.
TUND_MAX_DOMAINS_PER_USER=0
# Concurrent online tunnels, enforced by the server; the dashboard only displays it.
TUND_MAX_TUNNELS_PER_USER=0
# Teams a user may own (unset = 3, 0 = unlimited). The pinned/domain limits apply per team to team domains.
TUND_MAX_TEAMS_PER_USER=3

# Anti-phishing: browsers visiting unprotected tunnels on the base domain see a one-time
# warning page (shown by the edge; the dashboard labels affected tunnels). Must match the server.
TUND_BROWSER_WARNING=false
# Email address or http(s) URL for the "Report abuse" link on the landing page.
TUND_ABUSE_CONTACT=
# Server-side settings, listed here so Admin → Settings shows the same defaults as tund-server.
TUND_AUTO_PIN=true
TUND_RETENTION_DAYS=7
TUND_CAPTURE_MAX_BODY=262144
# Bandwidth defaults (0 = unlimited): per account and direction in kbit/s, per account and month in GB.
TUND_BANDWIDTH_KBPS=0
TUND_TRANSFER_GB=0
# Abuse protection defaults (all editable under Admin → Settings):
# custom domains of non-trusted accounts: allow | review | deny
TUND_UNTRUSTED_CUSTOM_DOMAINS=review
TUND_UNTRUSTED_TCP=true
TUND_UNTRUSTED_TLS=true
# Google Safe Browsing v4 key (optional; also used for custom domain reviews)
TUND_SAFE_BROWSING_API_KEY=
