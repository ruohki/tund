# --- required -------------------------------------------------------------
# Tunnels get <name>.$TUND_BASE_DOMAIN. Point a wildcard DNS record
# (*.tund.example.com) at this server.
TUND_BASE_DOMAIN=tund.example.com
# Public IPv4 of this server, shown in the custom-domain DNS instructions.
TUND_SERVER_IP=203.0.113.10
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
TUND_SECRET=
TUND_INTERNAL_SECRET=

# --- optional -------------------------------------------------------------
# Dashboard + client endpoint (default: dashboard.$TUND_BASE_DOMAIN)
# TUND_DASHBOARD_HOST=dashboard.tund.example.com
# Old hostnames that should permanently redirect to the dashboard, e.g. after
# moving to a new domain (comma-separated; certificates are obtained for them)
# TUND_REDIRECT_HOSTS=tund.old-domain.example

# TCP tunnels (`tund tcp 22`): a public port range the edge may use, and the
# hostname shown in tcp:// URLs (default: the dashboard host). Open the range
# in your firewall. Leave empty to disable TCP tunnels.
# TUND_TCP_PORTS=20000-20999
# TUND_TCP_HOST=tund.example.com

# Abuse protection defaults (all editable under Admin -> Settings):
# custom domains of non-trusted accounts: allow | review | deny
# TUND_UNTRUSTED_CUSTOM_DOMAINS=review
# TUND_UNTRUSTED_TCP=true
# TUND_UNTRUSTED_TLS=true
# TUND_SAFE_BROWSING_API_KEY=
# Per-account bandwidth (kbit/s per direction) and monthly transfer (GB); 0 = unlimited
# TUND_BANDWIDTH_KBPS=0
# TUND_TRANSFER_GB=0
# Where client binaries are published (default: the project's GitHub Releases)
# TUND_DOWNLOAD_BASE_URL=https://github.com/ruohki/tund/releases/latest/download

# Time zone for server-rendered timestamps and logs
# TZ=Europe/Berlin
# Allow anyone to sign up (the first account is always allowed and is admin)
# TUND_ALLOW_SIGNUP=false

# TLS: "acme" (Let's Encrypt, default), "manual" (own wildcard cert), "off"
# TUND_TLS_MODE=acme
# TUND_ACME_EMAIL=you@example.com
# Use the Let's Encrypt staging CA while testing:
# TUND_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Wildcard certificate via DNS-01 (recommended: one cert for all tunnels,
# no per-tunnel issuance). hetzner = Hetzner Cloud DNS API token,
# hetzner-legacy = dns.hetzner.com token, cloudflare = API token with Zone.DNS:Edit,
# bunny = bunny.net account API key
# TUND_DNS_PROVIDER=hetzner
# TUND_DNS_API_TOKEN=

# Bytes of each request/response body kept for the inspector, and how many days
# captured traffic is kept.
# Limits for a public service (0 = unlimited; admins are exempt)
# TUND_MAX_TUNNELS_PER_USER=5
# TUND_MAX_PINNED_PER_USER=3        # static hostnames (<name>.$TUND_BASE_DOMAIN)
# TUND_MAX_DOMAINS_PER_USER=5       # custom domains
# TUND_MAX_TEAMS_PER_USER=3         # teams a user may own
# Custom domains for every account (default false; admins can also turn them on per account)
# TUND_CUSTOM_DOMAINS=false
# TCP and TLS passthrough tunnels for every account (default false; admins can
# also turn them on per account)
# TUND_PASSTHROUGH=false
# Give every account a static hostname on its first `tund http` (default true)
# TUND_AUTO_PIN=true
# Anti-phishing warning page for browser visitors of <name>.$TUND_BASE_DOMAIN
# (recommended for public services), and where people can report abuse
# TUND_BROWSER_WARNING=true
# TUND_ABUSE_CONTACT=abuse@tund.example.com

# TUND_CAPTURE_MAX_BODY=262144
# TUND_RETENTION_DAYS=7
